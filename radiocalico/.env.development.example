# Radio Calico Development Environment Configuration

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Database (optional - uses SQLite by default)
# Uncomment to use PostgreSQL for development
# DATABASE_URL=postgresql://radiocalico:password@localhost:5432/radiocalico

# Session Configuration (auto-generated if not set)
# Leave empty to use Flask's default secure key generation
SECRET_KEY=

# Note: In development, leave most settings empty or commented.
# Flask will use sensible defaults:
# - SQLite database at instance/radiocalico.db
# - Debug mode enabled with auto-reload
# - Secure session key auto-generated on each start
