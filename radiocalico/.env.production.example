# Production Environment Configuration
# Copy this file to .env.production and set secure values before deployment
# WARNING: NEVER commit .env files to git - they are gitignored for security

# Database Password (REQUIRED - Production only)
# Generate a secure password (minimum 32 characters):
#   openssl rand -base64 32
#   OR
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=your_secure_password_here_minimum_32_chars

# Flask Configuration (optional)
FLASK_ENV=production
FLASK_DEBUG=0

# Secret Key (optional - if not set, regenerates on app restart)
# Only set this if you need persistent sessions across restarts
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=your_secret_key_here
